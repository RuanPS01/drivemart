# Configuração do app web do Firebase (Console > Configurações do projeto > Seus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Chave do reCAPTCHA Enterprise para o App Check (opcional, recomendado em produção).
VITE_RECAPTCHA_SITE_KEY=
# true = usa os emuladores locais (npm run dev:all), com o projeto demo-drivemart.
VITE_USE_EMULATORS=false
