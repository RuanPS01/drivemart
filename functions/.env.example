# Copie para functions/.env.<id-do-projeto> (ex.: functions/.env.drivemart-prod) antes do deploy.
# URL pública da função de webhook (aparece no fim do primeiro deploy).
MP_WEBHOOK_URL=https://southamerica-east1-SEU-PROJETO.cloudfunctions.net/mercadoPagoWebhook
# mercadopago (padrão em produção) ou fake (só testes; no emulador o padrão já é fake).
PAYMENT_PROVIDER=mercadopago
# true exige App Check nas funções chamadas pelo app (recomendado depois de configurar o reCAPTCHA).
ENFORCE_APP_CHECK=false
